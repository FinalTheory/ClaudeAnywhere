VPS_WS_URL=wss://your-relay.example.com/ws/client
# The same value as server/.env's AUTH_TOKEN — one secret, deliberately.
# Generate one with: openssl rand -hex 32
AUTH_TOKEN=generate-me-openssl-rand-hex-32
CDP_PORT=9222
POLL_INTERVAL_MS=1500

# Optional. When set, the daemon also watches ../server and rsyncs it to the
# VPS on every save, so one process deploys both halves. Unset to disable.
# The path is where server.py lives on the VPS — it does not have to mirror
# this checkout's directory names.
# DEPLOY_TARGET=you@your-relay.example.com:/opt/claude-anywhere

# Optional. When set, the daemon requests it after each deploy and says so
# loudly if the server stopped answering — a bad save otherwise takes
# production down with the traceback somewhere nobody is looking.
# HEALTH_URL=https://your-relay.example.com/healthz
