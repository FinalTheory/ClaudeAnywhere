VPS_WS_URL=wss://your-vps.example.com/ws/client
AUTH_TOKEN=change-me-to-a-long-random-string
CDP_PORT=9222
POLL_INTERVAL_MS=1500

# Auto-deploy (optional — unset DEPLOY_TARGET to disable):
# local remote/server/* -> god@finaltheory.me:/home/god/services/remote/
# (note the mapping isn't remote/server -> .../remote/server — the VPS path
# doesn't have the extra /server segment, since that's just this checkout's
# own directory name, not something the deploy target needs to mirror)
DEPLOY_TARGET=god@finaltheory.me:/home/god/services/remote
