# Secrets — never commit
client/.env
server/.env

# Runtime state, not source
client/daemon.log
server/data/
**/__pycache__/

# Vendored from the installed Claude Code extension
# (server/static/claude-webview.css) — not our code, version-specific,
# ~400KB. Re-copy from
# ~/.vscode-server/extensions/anthropic.claude-code-*/webview/index.css
# when setting this up fresh; see README.
server/static/claude-webview.css

# CDP spike/debugging tools — already served their purpose (see README's
# "confirmed empirically" section). cdp-client.js is a real dependency
# (daemon.js requires it) and stays tracked; these don't.
/detect-running-state.js
/diagnose.js
/inspect-tabs.js
/list-targets.js
/read-transcript.js
/read-transcript-html.js
/scan-frames.js
/send-prompt.js
/verify-push.js

# Ad-hoc dump files that accumulate here during debugging sessions
*.txt
*.json
!package.json
!package-lock.json
!server/requirements.txt

node_modules/
