# Secrets — never commit
client/.env
server/.env

# Runtime state, not source
client/daemon.log
server/data/
**/__pycache__/
node_modules/

# Vendored from the installed Claude Code extension
# (server/static/claude-webview.css) — not our code, version-specific,
# ~400KB. Re-copy from the extension's webview/index.css when setting this
# up fresh; see AGENTS.md.
server/static/claude-webview.css

# Everything at the repo root that is not source. Every real source file
# lives under client/, server/ or tests/, so the root is only ever
# throwaway: CDP spikes, probe scripts, captured DOM, dumped output. A
# pattern rather than a list, because the list was always one debugging
# session out of date.
/*.js
/*.txt
/*.json
/*.html
/*.css
!/package.json
!/package-lock.json
